# ═══════════════════════════════════════════════════════════════════════════
# AI Risk Manager - Production Environment Configuration (Render/Cloud)
# ═══════════════════════════════════════════════════════════════════════════
# Last Updated: 2026-09-01
# IMPORTANT: Set these values in your Render dashboard, not in this file!
# This file is for reference only. Do NOT commit actual secrets here.

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY LIVE MODE CREDENTIALS (Render Dashboard)
# ─────────────────────────────────────────────────────────────────────────────
# BEFORE GOING LIVE: Replace test credentials with LIVE credentials
# Get from: https://dashboard.razorpay.com/app/keys (switch to Live Mode)
# Set these as Environment Variables in Render Dashboard → Settings → Environment
#
# RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID_HERE
# RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET_HERE
#
# WARNING: LIVE MODE REQUIRES:
# 1. Razorpay account activation with KYC verification
# 2. Payment gateway activation
# 3. Proper SSL/TLS setup
# 4. Webhook verification setup

# ─────────────────────────────────────────────────────────────────────────────
# API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# API base URL for production deployment
API_BASE=https://ai-risk-manager-api.onrender.com
API_PORT=8000
API_HOST=0.0.0.0
API_ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Streamlit dashboard settings (Render manages port automatically)
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
DASHBOARD_ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────────────────────
# MERCHANT WEBHOOK CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# URL where merchant will receive fraud decision callbacks
MERCHANT_WEBHOOK_URL=https://ai-risk-manager-api.onrender.com/webhooks/merchant
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRY_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Production logging: INFO level, structured JSON format
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=./audit/decisions.jsonl
EVIDENCE_PACK_PATH=./audit/evidence_packs/

# Optional: Send logs to external service
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# CLOUDWATCH_LOG_GROUP=/aws/lambda/ai-risk-manager

# ─────────────────────────────────────────────────────────────────────────────
# MODEL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
MODEL_PATH=./artifacts/lgbm_risk_model.txt
CALIBRATOR_PATH=./artifacts/isotonic_calibrator.pkl
METADATA_PATH=./artifacts/model_metadata.json
EXPLAINER_TYPE=shap

# ─────────────────────────────────────────────────────────────────────────────
# FRAUD DECISION THRESHOLDS (Production - HIGH PRECISION)
# ─────────────────────────────────────────────────────────────────────────────
# Conservative thresholds to minimize false positives
# Adjust based on your risk tolerance
FRAUD_THRESHOLD_DECLINE=0.90
FRAUD_THRESHOLD_2FA=0.70

# ─────────────────────────────────────────────────────────────────────────────
# COLD START & FALLBACK CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_COLD_START=true
COLD_START_THRESHOLD=0.6
FALLBACK_STRATEGY=approve_with_monitoring

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AUDIT_TRAIL=true
ENABLE_DRIFT_DETECTION=true
ENABLE_BATCH_SCORING=true
ENABLE_MERCHANT_WEBHOOKS=true

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: EXTERNAL INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Database for persistent audit trail
# DATABASE_URL=postgresql://user:password@host:5432/ai_risk_manager

# ─────────────────────────────────────────────────────────────────────────────
# CORS & SECURITY (Production - Restrictive)
# ─────────────────────────────────────────────────────────────────────────────
# Only allow requests from trusted origins
CORS_ORIGINS=https://your-merchant-dashboard.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ─────────────────────────────────────────────────────────────────────────────
# SSL/TLS & SECURITY HEADERS
# ─────────────────────────────────────────────────────────────────────────────
HTTPS_ONLY=true
SECURE_HEADERS=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
