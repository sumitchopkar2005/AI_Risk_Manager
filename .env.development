# ═══════════════════════════════════════════════════════════════════════════
# AI Risk Manager - Development Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Last Updated: 2026-09-01
# Usage: cp .env.development .env (or load directly in IDE)

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY TEST MODE CREDENTIALS
# These are TEST credentials for development/testing only
# Get from: https://dashboard.razorpay.com/app/keys (switch to Test Mode)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_TWr4fta9oXjr7X
RAZORPAY_KEY_SECRET=gUmodDq44vUvZwKk1pj2Fsom

# ─────────────────────────────────────────────────────────────────────────────
# API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# API base URL for dashboard and external integrations
API_BASE=http://localhost:8000
API_PORT=8000
API_HOST=0.0.0.0
API_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Streamlit dashboard settings
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
DASHBOARD_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# MERCHANT WEBHOOK CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# URL where merchant will receive fraud decision callbacks
MERCHANT_WEBHOOK_URL=http://localhost:8000/webhooks/merchant
WEBHOOK_TIMEOUT=5
WEBHOOK_RETRY_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json
AUDIT_LOG_PATH=./audit/decisions.jsonl
EVIDENCE_PACK_PATH=./audit/evidence_packs/

# ─────────────────────────────────────────────────────────────────────────────
# MODEL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# LightGBM model paths and settings
MODEL_PATH=./artifacts/lgbm_risk_model.txt
CALIBRATOR_PATH=./artifacts/isotonic_calibrator.pkl
METADATA_PATH=./artifacts/model_metadata.json
EXPLAINER_TYPE=shap

# ─────────────────────────────────────────────────────────────────────────────
# FRAUD DECISION THRESHOLDS
# ─────────────────────────────────────────────────────────────────────────────
# Risk score thresholds (0.0 to 1.0)
# HIGH_PRECISION mode: fewer false positives, catches most fraud
FRAUD_THRESHOLD_DECLINE=0.85
FRAUD_THRESHOLD_2FA=0.65

# ─────────────────────────────────────────────────────────────────────────────
# COLD START & FALLBACK CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Handling new merchants/transactions without sufficient history
ENABLE_COLD_START=true
COLD_START_THRESHOLD=0.5
FALLBACK_STRATEGY=approve_with_monitoring

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AUDIT_TRAIL=true
ENABLE_DRIFT_DETECTION=true
ENABLE_BATCH_SCORING=true
ENABLE_MERCHANT_WEBHOOKS=true

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: EXTERNAL INTEGRATIONS (add as needed)
# ─────────────────────────────────────────────────────────────────────────────
# Database (if using for audit trail)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_risk_manager

# Logging service (e.g., Sentry, CloudWatch)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# CLOUDWATCH_LOG_GROUP=/aws/lambda/ai-risk-manager

# ─────────────────────────────────────────────────────────────────────────────
# CORS & SECURITY (Development Permissive)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
