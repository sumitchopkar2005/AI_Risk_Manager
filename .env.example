# ═══════════════════════════════════════════════════════════════════════════
# AI Risk Manager - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual credentials
# 3. Never commit .env files to version control
# 4. For development: use TEST credentials from Razorpay dashboard
# 5. For production: use LIVE credentials and secure them in Render/Cloud

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY API CREDENTIALS (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# TEST mode: Look for rzp_test_* keys (recommended for development)
# LIVE mode: Look for rzp_live_* keys (requires Razorpay activation)

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ─────────────────────────────────────────────────────────────────────────────
# API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
API_BASE=http://localhost:8000
API_PORT=8000
API_HOST=0.0.0.0
API_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
DASHBOARD_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# MERCHANT WEBHOOK CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Set this to your webhook receiver endpoint
MERCHANT_WEBHOOK_URL=http://localhost:8000/webhooks/merchant
WEBHOOK_TIMEOUT=5
WEBHOOK_RETRY_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json
AUDIT_LOG_PATH=./audit/decisions.jsonl
EVIDENCE_PACK_PATH=./audit/evidence_packs/

# ─────────────────────────────────────────────────────────────────────────────
# MODEL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
MODEL_PATH=./artifacts/lgbm_risk_model.txt
CALIBRATOR_PATH=./artifacts/isotonic_calibrator.pkl
METADATA_PATH=./artifacts/model_metadata.json
EXPLAINER_TYPE=shap

# ─────────────────────────────────────────────────────────────────────────────
# FRAUD DECISION THRESHOLDS
# ─────────────────────────────────────────────────────────────────────────────
# Risk score ranges from 0.0 (safe) to 1.0 (fraudulent)
FRAUD_THRESHOLD_DECLINE=0.85      # Auto-decline if risk >= 85%
FRAUD_THRESHOLD_2FA=0.65          # Require 2FA if risk >= 65%

# ─────────────────────────────────────────────────────────────────────────────
# COLD START & FALLBACK CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_COLD_START=true
COLD_START_THRESHOLD=0.5
FALLBACK_STRATEGY=approve_with_monitoring

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AUDIT_TRAIL=true
ENABLE_DRIFT_DETECTION=true
ENABLE_BATCH_SCORING=true
ENABLE_MERCHANT_WEBHOOKS=true

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: EXTERNAL INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment and configure if needed

# PostgreSQL Database
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_risk_manager

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# AWS CloudWatch Logging
# CLOUDWATCH_LOG_GROUP=/aws/lambda/ai-risk-manager
# AWS_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# CORS & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*